{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!.*(@nestjs\\+bullmq|@nestjs\\+bull-shared|@nestjs/bullmq|@nestjs/bull-shared|puppeteer|puppeteer-core))"
  ]
}

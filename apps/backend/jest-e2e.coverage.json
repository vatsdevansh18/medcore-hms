{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "maxWorkers": 1,
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "setupFilesAfterEnv": ["<rootDir>/test/helpers/reset-rate-limits.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!.*(@nestjs\\+bullmq|@nestjs\\+bull-shared|@nestjs/bullmq|@nestjs/bull-shared|puppeteer|puppeteer-core))"
  ],
  "collectCoverage": true,
  "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.spec.ts", "!src/main.ts"],
  "coverageDirectory": "coverage-e2e",
  "coverageReporters": ["text-summary", "html", "json-summary"]
}

// MedCore HMS — Prisma schema
// Source of truth for this schema is docs/06-DATABASE-DESIGN.md. Every model
// here should trace back to a row in that document's entity tables; if you
// change one, change the other in the same commit (docs/12-QUALITY-PROTOCOL.md §19).
//
// Enums here mirror packages/types/src/enums.ts exactly — that package is
// the single source of truth for the shared shape; this schema is generated
// against it, not the other way around.
//
// The two PostgreSQL EXCLUDE constraints that make double-booking impossible
// at the database level (docs/03-ARCHITECTURE.md §8, docs/11-DECISIONS.md D-005)
// cannot be expressed in Prisma's schema DSL — they're hand-written into the
// migration SQL (prisma/migrations/.../migration.sql) instead.

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev (Windows/macOS/glibc Linux); the musl target
  // is required for the node:20-alpine Docker images (infrastructure/docker),
  // whose OpenSSL 3.x didn't match Prisma's default-guessed engine binary at
  // runtime — see docs/phase-reviews/PHASE-2-REVIEW.md.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_TECHNICIAN
  PHARMACIST
  ACCOUNTANT
  PATIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum HospitalStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ReferenceRangeGender {
  MALE
  FEMALE
  ANY
}

enum RoomType {
  GENERAL
  PRIVATE
  ICU
  OT
}

enum BedStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  REGULAR
  EMERGENCY
  FOLLOW_UP
}

enum FamilyHistoryCondition {
  DIABETES
  HYPERTENSION
  CANCER
  CARDIAC
  OTHER
}

enum AttachmentOwnerType {
  MEDICAL_RECORD
  LAB_RESULT
  PRESCRIPTION
}

enum PrescriptionStatus {
  ISSUED
  PARTIALLY_DISPENSED
  DISPENSED
  CANCELLED
}

enum MedicineForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  TOPICAL
  OTHER
}

enum PrescriptionFrequency {
  OD
  BD
  TDS
  QID
  SOS
  OTHER
}

enum MedicineBatchStatus {
  ACTIVE
  QUARANTINED
  DEPLETED
}

enum LabOrderItemStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  RESULT_UPLOADED
  APPROVED
  REJECTED
}

enum LabOrderPriority {
  ROUTINE
  URGENT
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum InvoiceItemSourceType {
  CONSULTATION
  LAB
  PHARMACY
  ROOM
  OTHER
}

enum InsuranceClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

enum PaymentMethod {
  STRIPE
  RAZORPAY
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ─────────────────────────────────────────────────────────────────────────
// 1. Identity, Tenancy & Staff — docs/06-DATABASE-DESIGN.md §3.1
// ─────────────────────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(uuid())
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospitals Hospital[]
  patients  PatientProfile[]
}

/// Not tenant-scoped (it IS the tenant). Never auto-scoped by the tenant
/// Prisma extension — see src/common/tenancy/tenant-scoping.extension.ts.
model Hospital {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  status       HospitalStatus @default(PENDING_VERIFICATION)
  addressId    String?
  address      Address?       @relation(fields: [addressId], references: [id])
  contactEmail String
  contactPhone String?
  timezone     String         @default("Asia/Kolkata")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  departments    Department[]
  users          User[]
  rooms          Room[]
  medicines      Medicine[]
  labTests       LabTest[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  doctorProfiles DoctorProfile[]

  @@index([status])
}

model Department {
  id           String   @id @default(uuid())
  hospitalId   String
  hospital     Hospital @relation(fields: [hospitalId], references: [id])
  name         String
  description  String?
  /// Plain reference, not a formal relation, to avoid a circular
  /// Department<->DoctorProfile relation for a field that's informational only.
  headDoctorId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctors      DoctorProfile[]
  staff        StaffProfile[]
  rooms        Room[]
  appointments Appointment[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model User {
  id              String     @id @default(uuid())
  hospitalId      String?
  hospital        Hospital?  @relation(fields: [hospitalId], references: [id])
  email           String     @unique
  phone           String?
  passwordHash    String
  role            UserRole
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  doctorProfile    DoctorProfile?
  patientProfile   PatientProfile?
  staffProfile     StaffProfile?
  refreshSessions  RefreshTokenSession[]
  notifications    Notification[]
  auditLogsAsActor AuditLog[]            @relation("AuditActor")

  @@index([hospitalId])
  @@index([role])
}

model DoctorProfile {
  id                String     @id @default(uuid())
  userId            String     @unique
  user              User       @relation(fields: [userId], references: [id])
  hospitalId        String
  hospital          Hospital   @relation(fields: [hospitalId], references: [id])
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id])
  specialization    String
  licenseNumber     String
  qualification     String?
  yearsOfExperience Int?
  consultationFee   Decimal    @db.Decimal(10, 2)
  signatureImageUrl String?
  bio               String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?

  availability           DoctorAvailability[]
  availabilityExceptions DoctorAvailabilityException[]
  appointments           Appointment[]
  medicalRecords         MedicalRecord[]
  prescriptions          Prescription[]
  labOrders              LabOrder[]

  @@index([hospitalId])
  @@index([departmentId])
}

model PatientProfile {
  id                    String    @id @default(uuid())
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id])
  hospitalId            String
  dob                   DateTime? @db.Date
  gender                Gender?
  bloodGroup            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  addressId             String?
  address               Address?  @relation(fields: [addressId], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labOrders      LabOrder[]
  invoices       Invoice[]
  allergies      Allergy[]
  vaccinations   VaccinationRecord[]
  familyHistory  FamilyHistoryFlag[]
  admissions     Admission[]

  @@index([hospitalId])
}

/// Shared profile for Nurse, Receptionist, Lab Technician, Pharmacist,
/// Accountant, and Hospital Admin — see docs/11-DECISIONS.md D-006 for why
/// these six roles share one table instead of six near-identical ones.
model StaffProfile {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id])
  hospitalId   String
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  employeeCode String
  joinedAt     DateTime    @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([hospitalId, employeeCode])
  @@index([hospitalId])
}

model DoctorAvailability {
  id                  String        @id @default(uuid())
  doctorId            String
  doctor              DoctorProfile @relation(fields: [doctorId], references: [id])
  dayOfWeek           Int
  startTime           String
  endTime             String
  slotDurationMinutes Int           @default(30)
  isActive            Boolean       @default(true)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([doctorId])
}

model DoctorAvailabilityException {
  id            String        @id @default(uuid())
  doctorId      String
  doctor        DoctorProfile @relation(fields: [doctorId], references: [id])
  date          DateTime      @db.Date
  isUnavailable Boolean       @default(true)
  startTime     String?
  endTime       String?
  reason        String?
  createdAt     DateTime      @default(now())

  @@unique([doctorId, date])
  @@index([doctorId])
}

model RefreshTokenSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  deviceId    String
  deviceLabel String?
  ipAddress   String?
  userAgent   String?
  tokenHash   String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, deviceId])
  @@index([userId])
}

model Room {
  id           String     @id @default(uuid())
  hospitalId   String
  hospital     Hospital   @relation(fields: [hospitalId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  roomNumber   String
  type         RoomType
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  beds Bed[]

  @@unique([hospitalId, roomNumber])
  @@index([hospitalId])
}

model Bed {
  id        String    @id @default(uuid())
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id])
  bedNumber String
  status    BedStatus @default(VACANT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  admissions Admission[]

  @@unique([roomId, bedNumber])
}

/// Minimal occupancy tracking only — full IPD billing/clinical workflow is
/// out of MVP scope. See docs/11-DECISIONS.md D-007.
model Admission {
  id           String         @id @default(uuid())
  hospitalId   String
  patientId    String
  patient      PatientProfile @relation(fields: [patientId], references: [id])
  bedId        String
  bed          Bed            @relation(fields: [bedId], references: [id])
  admittedAt   DateTime       @default(now())
  dischargedAt DateTime?
  admittedBy   String

  @@index([hospitalId])
  @@index([bedId])
}

model AuditLog {
  id          String    @id @default(uuid())
  hospitalId  String?
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])
  actorUserId String?
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  beforeData  Json?
  afterData   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([hospitalId])
  @@index([entityType, entityId])
  @@index([actorUserId])
}

// ─────────────────────────────────────────────────────────────────────────
// 2. Appointments & Scheduling — docs/06-DATABASE-DESIGN.md §3.2
// ─────────────────────────────────────────────────────────────────────────

model Appointment {
  id              String            @id @default(uuid())
  hospitalId      String
  patientId       String
  patient         PatientProfile    @relation(fields: [patientId], references: [id])
  doctorId        String
  doctor          DoctorProfile     @relation(fields: [doctorId], references: [id])
  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id])
  scheduledStart  DateTime
  scheduledEnd    DateTime
  status          AppointmentStatus @default(PENDING)
  type            AppointmentType   @default(REGULAR)
  reasonForVisit  String?
  cancelledReason String?
  cancelledBy     String?
  createdBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  medicalRecord MedicalRecord?
  invoice       Invoice?

  @@index([hospitalId, scheduledStart])
  @@index([doctorId, scheduledStart])
  @@index([patientId, scheduledStart])
  @@index([hospitalId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// 3. Clinical Records & Prescriptions — docs/06-DATABASE-DESIGN.md §3.3
// ─────────────────────────────────────────────────────────────────────────

/// Core fields are immutable after creation — see docs/02-SRS.md FR-EMR-002.
/// `notesEncrypted` is application-level AES-256-GCM ciphertext, not plaintext
/// (docs/11-DECISIONS.md D-008) — never select/log this column casually.
model MedicalRecord {
  id                      String         @id @default(uuid())
  hospitalId              String
  appointmentId           String         @unique
  appointment             Appointment    @relation(fields: [appointmentId], references: [id])
  patientId               String
  patient                 PatientProfile @relation(fields: [patientId], references: [id])
  doctorId                String
  doctor                  DoctorProfile  @relation(fields: [doctorId], references: [id])
  chiefComplaint          String?
  presentingSymptoms      String?
  confirmedDiagnosisIcd10 String[]
  treatmentPlan           String?
  notesEncrypted          Bytes?
  createdAt               DateTime       @default(now())

  addenda       MedicalRecordAddendum[]
  vitals        Vitals[]
  attachments   Attachment[]
  prescriptions Prescription[]
  labOrders     LabOrder[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
}

model MedicalRecordAddendum {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  authorUserId    String
  noteEncrypted   Bytes
  createdAt       DateTime      @default(now())

  @@index([medicalRecordId])
}

model Vitals {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  bpSystolic      Int?
  bpDiastolic     Int?
  pulse           Int?
  temperatureC    Decimal?      @db.Decimal(4, 1)
  spo2            Int?
  heightCm        Decimal?      @db.Decimal(5, 1)
  weightKg        Decimal?      @db.Decimal(5, 1)
  bmi             Decimal?      @db.Decimal(4, 1)
  recordedBy      String
  recordedAt      DateTime      @default(now())

  @@index([medicalRecordId])
}

model Allergy {
  id         String         @id @default(uuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id])
  allergen   String
  reaction   String?
  severity   String?
  recordedAt DateTime       @default(now())

  @@index([patientId])
}

model VaccinationRecord {
  id               String         @id @default(uuid())
  patientId        String
  patient          PatientProfile @relation(fields: [patientId], references: [id])
  vaccineName      String
  doseNumber       Int
  dateAdministered DateTime       @db.Date
  batchNumber      String?
  nextDueDate      DateTime?      @db.Date

  @@index([patientId])
}

model FamilyHistoryFlag {
  id        String                 @id @default(uuid())
  patientId String
  patient   PatientProfile         @relation(fields: [patientId], references: [id])
  condition FamilyHistoryCondition
  notes     String?

  @@index([patientId])
}

model Attachment {
  id              String              @id @default(uuid())
  hospitalId      String
  ownerType       AttachmentOwnerType
  medicalRecordId String?
  medicalRecord   MedicalRecord?      @relation(fields: [medicalRecordId], references: [id])
  fileName        String
  mimeType        String
  sizeBytes       Int
  storageKey      String
  uploadedBy      String
  createdAt       DateTime            @default(now())

  @@index([hospitalId])
  @@index([medicalRecordId])
}

model Medicine {
  id           String       @id @default(uuid())
  hospitalId   String
  hospital     Hospital     @relation(fields: [hospitalId], references: [id])
  name         String
  genericName  String?
  form         MedicineForm
  manufacturer String?
  unit         String
  reorderLevel Int          @default(10)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  batches           MedicineBatch[]
  prescriptionItems PrescriptionItem[]

  @@index([hospitalId])
  @@index([hospitalId, name])
}

model MedicineBatch {
  id                String              @id @default(uuid())
  medicineId        String
  medicine          Medicine            @relation(fields: [medicineId], references: [id])
  hospitalId        String
  batchNumber       String
  manufacturingDate DateTime            @db.Date
  expiryDate        DateTime            @db.Date
  quantityOnHand    Int
  unitCost          Decimal             @db.Decimal(10, 2)
  mrp               Decimal             @db.Decimal(10, 2)
  status            MedicineBatchStatus @default(ACTIVE)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  dispenseRecords DispenseRecord[]

  @@unique([medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@index([hospitalId, status])
}

model Prescription {
  id                String             @id @default(uuid())
  hospitalId        String
  medicalRecordId   String
  medicalRecord     MedicalRecord      @relation(fields: [medicalRecordId], references: [id])
  doctorId          String
  doctor            DoctorProfile      @relation(fields: [doctorId], references: [id])
  patientId         String
  patient           PatientProfile     @relation(fields: [patientId], references: [id])
  signatureImageUrl String?
  pdfUrl            String?
  status            PrescriptionStatus @default(ISSUED)
  createdAt         DateTime           @default(now())

  items PrescriptionItem[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
}

model PrescriptionItem {
  id                  String                @id @default(uuid())
  prescriptionId      String
  prescription        Prescription          @relation(fields: [prescriptionId], references: [id])
  medicineId          String
  medicine            Medicine              @relation(fields: [medicineId], references: [id])
  dosage              String
  frequency           PrescriptionFrequency
  durationDays        Int
  specialInstructions String?
  quantityPrescribed  Int
  quantityDispensed   Int                   @default(0)

  dispenseRecords DispenseRecord[]

  @@index([prescriptionId])
}

/// FIFO-by-expiry (FEFO) dispensing trace — see docs/11-DECISIONS.md D-004.
model DispenseRecord {
  id                 String           @id @default(uuid())
  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id])
  medicineBatchId    String
  medicineBatch      MedicineBatch    @relation(fields: [medicineBatchId], references: [id])
  quantity           Int
  dispensedBy        String
  dispensedAt        DateTime         @default(now())

  @@index([prescriptionItemId])
  @@index([medicineBatchId])
}

// ─────────────────────────────────────────────────────────────────────────
// 4. Laboratory — docs/06-DATABASE-DESIGN.md §3.4
// ─────────────────────────────────────────────────────────────────────────

model LabTest {
  id              String   @id @default(uuid())
  hospitalId      String
  hospital        Hospital @relation(fields: [hospitalId], references: [id])
  name            String
  code            String
  sampleType      String?
  price           Decimal  @db.Decimal(10, 2)
  turnaroundHours Int?

  referenceRanges LabTestReferenceRange[]
  orderItems      LabOrderItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

/// Not directly tenant-scoped — access is always via its parent LabTest
/// (docs/03-ARCHITECTURE.md §5 "child tables rely on parent tenancy").
model LabTestReferenceRange {
  id        String               @id @default(uuid())
  labTestId String
  labTest   LabTest              @relation(fields: [labTestId], references: [id])
  gender    ReferenceRangeGender @default(ANY)
  ageMin    Int?
  ageMax    Int?
  lowValue  Decimal              @db.Decimal(10, 3)
  highValue Decimal              @db.Decimal(10, 3)
  unit      String

  @@index([labTestId])
}

model LabOrder {
  id              String           @id @default(uuid())
  hospitalId      String
  medicalRecordId String
  medicalRecord   MedicalRecord    @relation(fields: [medicalRecordId], references: [id])
  doctorId        String
  doctor          DoctorProfile    @relation(fields: [doctorId], references: [id])
  patientId       String
  patient         PatientProfile   @relation(fields: [patientId], references: [id])
  priority        LabOrderPriority @default(ROUTINE)
  createdAt       DateTime         @default(now())

  items LabOrderItem[]

  @@index([hospitalId])
  @@index([patientId])
  @@index([doctorId])
}

model LabOrderItem {
  id         String             @id @default(uuid())
  labOrderId String
  labOrder   LabOrder           @relation(fields: [labOrderId], references: [id])
  labTestId  String
  labTest    LabTest            @relation(fields: [labTestId], references: [id])
  status     LabOrderItemStatus @default(ORDERED)

  result LabResult?

  @@index([labOrderId])
  @@index([status])
}

model LabResult {
  id               String       @id @default(uuid())
  labOrderItemId   String       @unique
  labOrderItem     LabOrderItem @relation(fields: [labOrderItemId], references: [id])
  structuredValues Json?
  reportFileUrl    String?
  enteredBy        String
  approvedBy       String?
  approvedAt       DateTime?
  isOutOfRange     Boolean      @default(false)
  createdAt        DateTime     @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// 5. Billing, Notifications & Audit — docs/06-DATABASE-DESIGN.md §3.5
// ─────────────────────────────────────────────────────────────────────────

model Invoice {
  id            String         @id @default(uuid())
  hospitalId    String
  appointmentId String         @unique
  appointment   Appointment    @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id])
  status        InvoiceStatus  @default(DRAFT)
  subtotal      Decimal        @default(0) @db.Decimal(12, 2)
  tax           Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @default(0) @db.Decimal(12, 2)
  currency      String         @default("INR")
  finalizedBy   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items          InvoiceItem[]
  payments       Payment[]
  insuranceClaim InsuranceClaim?

  @@index([hospitalId])
  @@index([patientId])
  @@index([hospitalId, status])
}

model InvoiceItem {
  id          String                @id @default(uuid())
  invoiceId   String
  invoice     Invoice               @relation(fields: [invoiceId], references: [id])
  sourceType  InvoiceItemSourceType
  sourceId    String?
  description String
  quantity    Int                   @default(1)
  unitPrice   Decimal               @db.Decimal(10, 2)
  lineTotal   Decimal               @db.Decimal(10, 2)

  @@index([invoiceId])
}

/// Data model only in v1 — no TPA adjudication workflow (docs/11-DECISIONS.md D-011).
model InsuranceClaim {
  id          String               @id @default(uuid())
  invoiceId   String               @unique
  invoice     Invoice              @relation(fields: [invoiceId], references: [id])
  tpaName     String
  claimNumber String?
  status      InsuranceClaimStatus @default(SUBMITTED)
  submittedAt DateTime             @default(now())
}

model Payment {
  id                        String        @id @default(uuid())
  hospitalId                String
  invoiceId                 String
  invoice                   Invoice       @relation(fields: [invoiceId], references: [id])
  method                    PaymentMethod
  amount                    Decimal       @db.Decimal(12, 2)
  currency                  String        @default("INR")
  status                    PaymentStatus @default(PENDING)
  providerEventId           String?       @unique
  providerSignatureVerified Boolean       @default(false)
  rawPayloadSanitized       Json?
  createdAt                 DateTime      @default(now())

  @@index([hospitalId])
  @@index([invoiceId])
}

model Notification {
  id                String                @id @default(uuid())
  hospitalId        String?
  hospital          Hospital?             @relation(fields: [hospitalId], references: [id])
  recipientUserId   String
  recipient         User                  @relation(fields: [recipientUserId], references: [id])
  type              String
  title             String
  body              String
  channels          NotificationChannel[]
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime              @default(now())

  deliveryLogs NotificationDeliveryLog[]

  @@index([hospitalId])
  @@index([recipientUserId])
}

model NotificationDeliveryLog {
  id             String              @id @default(uuid())
  notificationId String
  notification   Notification        @relation(fields: [notificationId], references: [id])
  channel        NotificationChannel
  provider       String?
  status         NotificationStatus  @default(PENDING)
  errorMessage   String?
  attemptedAt    DateTime            @default(now())

  @@index([notificationId])
}

# syntax=docker/dockerfile:1
FROM node:20-alpine AS base
# Prisma's query engine binary needs a real libssl present — node:20-alpine's
# base image doesn't include it, which surfaces as a runtime crash
# ("Error loading shared library libssl.so.1.1") that's easy to miss until
# the container actually receives its first query, not at build time.
RUN apk add --no-cache openssl
# Phase 7 (prescription PDF generation, docs/03-ARCHITECTURE.md §12
# `pdf-generate` job): the bare `puppeteer` npm package bundles a
# glibc-linked Chromium download that does not run on musl-libc Alpine
# (missing shared libraries at launch, not at install time — the same class
# of "works natively, breaks in the Alpine image" surprise as the Prisma
# engine binary above). Installing Alpine's own `chromium` package and
# pointing Puppeteer at it via `PUPPETEER_EXECUTABLE_PATH` — with
# `PUPPETEER_SKIP_DOWNLOAD` so `pnpm install` doesn't waste time/bandwidth
# downloading a Chromium build that would never run — is the standard fix.
# Native Windows/macOS dev is unaffected: these env vars only take effect
# inside this image, so `pnpm install` there still downloads Puppeteer's own
# bundled Chromium normally.
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /workspace

# ---- deps: install once, reused by both the dev and prod build stages ----
FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY packages/types/package.json packages/types/package.json
COPY packages/config/package.json packages/config/package.json
COPY apps/backend/package.json apps/backend/package.json
RUN pnpm install --frozen-lockfile --filter=@medcore/backend...

# ---- dev: used by docker-compose.yml for local development (hot reload via bind mount) ----
FROM deps AS dev
COPY packages/types packages/types
COPY packages/config packages/config
COPY apps/backend apps/backend
# @medcore/types is consumed as compiled JS (see packages/types/package.json) — build it
# once into the image; apps/backend's own source is bind-mounted for hot reload instead.
RUN pnpm --filter=@medcore/types run build
# The Prisma Client generated during `pnpm install` (deps stage) has no schema
# to generate against yet — schema.prisma only arrives with this COPY. Without
# an explicit generate here, the client in node_modules is a schema-less stub
# (e.g. missing Prisma.ModelName, per-model delegates) and every model-typed
# import fails to compile — found running this exact image, see
# docs/phase-reviews/PHASE-2-REVIEW.md.
RUN pnpm --filter=@medcore/backend exec prisma generate
EXPOSE 3001
CMD ["pnpm", "--filter=@medcore/backend", "run", "dev"]

# ---- build: compiles the production bundle ----
FROM deps AS build
COPY packages/types packages/types
COPY packages/config packages/config
COPY apps/backend apps/backend
RUN pnpm --filter=@medcore/backend exec prisma generate
RUN pnpm -r --if-present run build

# ---- runtime: minimal production image (used from Phase 16 onward) ----
FROM base AS runtime
ENV NODE_ENV=production
COPY --from=build /workspace/apps/backend/dist ./apps/backend/dist
COPY --from=build /workspace/apps/backend/package.json ./apps/backend/package.json
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/backend/node_modules ./apps/backend/node_modules
COPY --from=build /workspace/packages ./packages
# The generated Prisma Client's query engine is already baked in at `prisma
# generate` time (build stage) and needs nothing further — but `prisma
# migrate deploy` is a separate CLI operation that reads schema.prisma and
# prisma/migrations/*.sql directly, and without this line those files never
# make it into the runtime image at all (only dist/ does). A container built
# from this image couldn't run its own migrations. Found while actually
# deploying for the first time (docs/13-DEPLOYMENT-RUNBOOK.md §13's command
# was never exercised against a real host until then).
COPY --from=build /workspace/apps/backend/prisma ./apps/backend/prisma
EXPOSE 3001
CMD ["node", "apps/backend/dist/main.js"]

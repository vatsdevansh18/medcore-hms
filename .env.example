# MedCore HMS — environment variable reference.
# Copy to .env and fill in real values for local dev. Never commit .env.
# Variables are grouped by the phase that wires them up (docs/05-DEVELOPMENT-PLAN.md).

# ── Phase 1: Application ────────────────────────────────────────────────
NODE_ENV=development
# Named API_PORT (not PORT) — Next.js also reads PORT by convention, and
# both apps share this .env file, so a generic PORT would collide.
API_PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Frontend (apps/frontend) — NEXT_PUBLIC_* vars are exposed to the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ── Phase 2: Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://medcore:medcore@localhost:5432/medcore_hms
POSTGRES_DB=medcore_hms
POSTGRES_USER=medcore
POSTGRES_PASSWORD=medcore

# ── Phase 2/13: Redis (sessions, cache, rate limiting, queues) ──────────
REDIS_URL=redis://localhost:6379

# ── Phase 3: Authentication ──────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-a-256-bit-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST_FACTOR=12

# ── Phase 6: File storage (S3) & field encryption ─────────────────────────
AWS_REGION=ap-south-1
# "test"/"test" work out of the box against the LocalStack dev service
# (docker-compose.yml) — replace with real credentials only in production.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_BUCKET=medcore-hms-attachments
# Dev/test only (docs/11-DECISIONS.md D-015) — points the AWS SDK at the
# local LocalStack container instead of real AWS. Leave blank in production
# so the SDK talks to real S3. Native dev (outside Docker): http://localhost:4566
S3_ENDPOINT=http://localhost:4566

# AES-256-GCM key for application-level field encryption of clinical notes
# (docs/11-DECISIONS.md D-008) — 64 hex characters (32 bytes). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-char-hex-256-bit-key

# Optional — profile-photo transforms only, never clinical documents (see docs/11-DECISIONS.md D-012)
CLOUDINARY_URL=

# ── Phase 10: Payments (test mode only) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Phase 11: Notifications ───────────────────────────────────────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Phase 16: Observability ───────────────────────────────────────────────
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=
